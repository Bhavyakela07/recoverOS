# PostgreSQL Configuration
POSTGRES_USER=recoveros
POSTGRES_PASSWORD=recoveros_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=recoveros

# Razorpay Test Mode (development only)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXX
RAZORPAY_KEY_SECRET=rzp_test_XXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=webhook_secret_XXXXXX

# Claude API Configuration
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXX
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=0.1

# ML Model
XGBOOST_MODEL_PATH=./models/recovery_model.xgb
SYNTHETIC_DATASET_PATH=./data/recovery_leak_dataset.csv

# App Configuration
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# Demo/Replay Mode
DEMO_SEED=42
DEMO_CASE_COUNT=50
HOLDOUT_RATIO=0.15

# Security & Auth
AUTH_SECRET_KEY=recoveros_auth_secret_buildathon_2026_demo_key
SESSION_TIMEOUT=3600

# OAuth 2.0 Providers (Optional for Live Google / GitHub SSO)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8501

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8501

# Monitoring
AUDIT_LOG_PATH=./logs/audit.log
METRICS_PORT=9090

# SMTP / Email Notification Configuration (Gmail / Outlook / Custom SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_NAME=RecoverOS AI