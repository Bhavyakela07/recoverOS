# PostgreSQL Configuration
POSTGRES_USER=recoveros
POSTGRES_PASSWORD=recoveros_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=recoveros

# Razorpay Test Mode (development only)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXX
RAZORPAY_KEY_SECRET=rzp_test_XXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=webhook_secret_XXXXXX

# Claude API Configuration
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXX
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=0.1

# ML Model
XGBOOST_MODEL_PATH=./models/recovery_model.xgb
SYNTHETIC_DATASET_PATH=./data/recovery_leak_dataset.csv

# App Configuration
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# Demo/Replay Mode
DEMO_SEED=42
DEMO_CASE_COUNT=50
HOLDOUT_RATIO=0.15

# Security
ENCRYPTION_KEY=your_encryption_key_here
SESSION_TIMEOUT=3600

# Monitoring
AUDIT_LOG_PATH=./logs/audit.log
METRICS_PORT=9090